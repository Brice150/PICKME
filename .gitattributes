# Normalise the line endings so that a checkout on Windows and one on Linux hold the same content.
* text=auto eol=lf

# Binaries, left untouched.
*.png binary
*.jpg binary
*.ico binary
*.jar binary

# The Windows launcher of the Maven wrapper needs CRLF to run.
*.cmd text eol=crlf
*.bat text eol=crlf

# Generated, hidden from the diff of a pull request.
package-lock.json linguist-generated=true
